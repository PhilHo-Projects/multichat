# Copy this to .env for local experiments, or set the same names in Coolify.
# Never commit a real .env file.

# --- Provider keys -----------------------------------------------------------------
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# google or nvidia
DEFAULT_PROVIDER=nvidia
DEFAULT_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant. Answer clearly and concisely. If you are unsure, say so.

# --- Auth: required. The server refuses to start without these. ----------------------
# No fallbacks by design: an app that will not boot is a loud failure, one running on a
# known default is a silent one.
PUBLIC_ORIGIN=https://chat.philippeho.dev
# openssl rand -hex 32
SESSION_SECRET=
OWNER_EMAIL=
# Bootstrap only, minimum 12 characters. Used on the first boot that finds no owner row
# and ignored for ever after; changing it later does nothing.
OWNER_PASSWORD=

OWNER_USERNAME=phil

# --- Storage -------------------------------------------------------------------------
# /data is a bind mount from /home/phil/app-data/philchat in production.
PHILCHAT_DB_PATH=/data/philchat.sqlite

# --- Guest trial ---------------------------------------------------------------------
GUEST_MESSAGE_LIMIT=5
GUEST_DAILY_MESSAGE_LIMIT=50
# Comma-separated model ids guests may use. Empty means every model.
GUEST_MODEL_ALLOWLIST=

# --- Token budgets -------------------------------------------------------------------
DEFAULT_MONTHLY_TOKEN_BUDGET=500000
GLOBAL_DAILY_TOKEN_LIMIT=2000000

# --- Local dev -----------------------------------------------------------------------
PORT=8791

# Optional: Google Cloud Monitoring quota dashboard (owner-only endpoint)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_QUOTA_LOOKBACK_HOURS=24
